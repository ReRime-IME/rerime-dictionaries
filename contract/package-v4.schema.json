{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format_version",
    "payload_kind",
    "profile",
    "package_revision",
    "release_id",
    "compatibility_id",
    "engine_archive_sha256",
    "recipe_sha256",
    "minimum_app_version",
    "minimum_app_build",
    "qualified_os",
    "glyph_policy_version",
    "upstream_revision",
    "adapter_revision",
    "source_digest",
    "build_receipt_sha256",
    "source_archive_sha256",
    "english_learning_version",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 4
    },
    "payload_kind": {
      "type": "string",
      "const": "precompiled-rime-v1"
    },
    "profile": {
      "type": "string",
      "const": "mobile_wanxiang_full"
    },
    "package_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "release_id": {
      "type": "string",
      "pattern": "wanxiang-precompiled-[1-9][0-9]*-[0-9a-f]{12}"
    },
    "compatibility_id": {
      "type": "string",
      "const": "wanxiang-ios-arm64-rime1161-v1"
    },
    "engine_archive_sha256": {
      "type": "string",
      "const": "d123d38b004d60548eef21c2688c17a9b988c8565dd8aee334a8fe215f273bd5"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "minimum_app_version": {
      "type": "string",
      "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "minimum_app_build": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "qualified_os": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "[0-9]+\\.[0-9]+"
      }
    },
    "glyph_policy_version": {
      "type": "integer",
      "const": 1
    },
    "upstream_revision": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "adapter_revision": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "source_digest": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "build_receipt_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "source_archive_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "english_learning_version": {
      "type": "integer",
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "LICENSE",
              "LICENSE-rime-ice.txt",
              "NOTICE.md",
              "build-receipt.json",
              "build/default.yaml",
              "build/wanxiang.prism.bin",
              "build/wanxiang.reverse.bin",
              "build/wanxiang.schema.yaml",
              "build/wanxiang.table.bin",
              "build/wanxiang_english.prism.bin",
              "build/wanxiang_english.reverse.bin",
              "build/wanxiang_english.schema.yaml",
              "build/wanxiang_english.table.bin",
              "build/wanxiang_mixedcode.prism.bin",
              "build/wanxiang_mixedcode.reverse.bin",
              "build/wanxiang_mixedcode.schema.yaml",
              "build/wanxiang_mixedcode.table.bin",
              "default.yaml",
              "opencc/LICENSE",
              "opencc/STCharacters.ocd2",
              "opencc/STPhrases.ocd2",
              "opencc/emoji.json",
              "opencc/emoji.txt",
              "opencc/others.txt",
              "opencc/s2t.json",
              "qualification.json",
              "upstream-lock.json"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        }
      }
    }
  }
}
